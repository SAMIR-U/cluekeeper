NODE_ENV=development
PORT=4000

# Obligatorio en producción (mínimo 32 caracteres): openssl rand -base64 48
JWT_SECRET=

# Orígenes del frontend React autorizados (separados por coma, sin "/" final)
CORS_ORIGINS=http://localhost:5173
# URL pública del frontend; el QR de acceso apunta a <APP_BASE_URL>/join?token=...
APP_BASE_URL=http://localhost:5173

# Frontend y API en dominios distintos (GitHub Pages / Vercel): none + Secure
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# TRUST_PROXY=1

# PostgreSQL (obligatorio en producción). En Render: "Internal Database URL"
# DATABASE_URL=postgresql://usuario:clave@host:5432/cluekeeper
# DATABASE_SSL=true            # solo si usas la URL externa/pública
# Sin DATABASE_URL (solo desarrollo) se usa PGlite, un Postgres embebido en ./data/pglite

# Organizador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=organizador@cluekeeper.test
ADMIN_PASSWORD=cambia-esta-clave

# MAX_GEO_ACCURACY_M=100
# LATE_SYNC_GRACE_MINUTES=120
