{
  "name": "cluekeeper-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST de ClueKeeper (rally de observación)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
